{
  "name": "the-commute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Station tycoon on a 3D map of the Stockport to Manchester line",
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test test/*.test.ts",
